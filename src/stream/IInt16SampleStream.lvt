namespace Livt.Signal.Stream

/**
 * Unscaled signed-16 samples with valid/ready flow control and frame markers.
 */
interface IInt16SampleStream
{
	// Signed payload, transfer handshake, and non-empty-frame boundaries.
	sample: in logic[16]
	valid: in bool
	first: in bool
	last: in bool
	ready: out bool
}
