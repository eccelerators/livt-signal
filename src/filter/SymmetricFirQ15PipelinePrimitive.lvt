namespace Livt.Signal.Filter

/**
 * Native symmetric FIR datapath with one multiplier per mirrored tap pair.
 */
@Opaque
component SymmetricFirQ15PipelinePrimitive
{
	// Native stream and datapath ports used by the public wrapper.
	public inputValid: in bool
	public inputReady: out bool
	public inputSample: in logic[16]
	public inputFirst: in bool
	public inputLast: in bool
	public outputValid: out bool
	public outputReady: in bool
	public outputSample: out logic[16]
	public outputFirst: out bool
	public outputLast: out bool

	/**
	 * Configures a symmetric fixed coefficient vector and fixed-point format.
	 */
	new(coefficients: int[], coefficientBits: int,
		coefficientFractionBits: int) {}
}
